# 国内部署默认使用阿里云 PyPI 源；海外部署改为 global 并覆盖 PIP_INDEX_URL。
KB_BUILD_REGION=cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
MEILI_MASTER_KEY=local-dev-only-change-me

# Deployment defaults for the editable 配置 page. UI overrides are persisted in PostgreSQL.
# Main AI provider: ollama or openai (OpenAI-compatible /chat/completions).
# For DeepSeek, enter its OpenAI-compatible base URL, model, and key on the 配置 page.
KB_AI_PROVIDER=ollama
KB_AI_BASE_URL=http://127.0.0.1:11434
KB_AI_MODEL=qwen3:14b
KB_AI_API_KEY=

# Embeddings are independent from the main AI provider. Keep BGE-M3 on Ollama,
# or choose an OpenAI-compatible /embeddings endpoint on the 配置 page.
KB_EMBEDDING_PROVIDER=ollama
KB_EMBEDDING_BASE_URL=http://127.0.0.1:11434
KB_EMBEDDING_MODEL=bge-m3
KB_EMBEDDING_API_KEY=

# Optional Infinity-compatible Cross-Encoder reranker.
KB_RERANKER_BASE_URL=
KB_RERANKER_MODEL=bge-reranker-v2-m3
KB_RERANKER_TIMEOUT_SECONDS=20
